          </div>

          <div class="sp-card wide">
            <div class="sp-card-title">🎨 Appearance</div>
            <div class="sp-row">
              <span class="sp-row-lbl">UI Scale</span>
              <div style="display:flex;align-items:center;gap:6px;">
                <input type="range" id="sp-ui-scale" min="70" max="130" value="${s.uiScale}" style="width:80px;accent-color:${s.accentColor};cursor:pointer;">
                <span id="sp-ui-scale-val" style="font-size:10px;color:var(--text-dim);font-family:'DM Mono',monospace;min-width:34px;">${s.uiScale}%</span>
              </div>
            </div>
            <div class="sp-row">
              <span class="sp-row-lbl">Grid opacity</span>
              <div style="display:flex;align-items:center;gap:6px;">
                <input type="range" id="sp-opacity" min="10" max="100" value="${s.gridOpacity}" style="width:80px;accent-color:${s.accentColor};cursor:pointer;">
                <span id="sp-opacity-val" style="font-size:10px;color:var(--text-dim);font-family:'DM Mono',monospace;min-width:34px;">${s.gridOpacity}%</span>
              </div>
            </div>
            <div class="sp-row">
              <span class="sp-row-lbl">Accent color</span>
              <div style="display:flex;align-items:center;gap:5px;">
                ${mkSwatches('accent', s.accentColor)}
                <input type="color" id="sp-accent-custom" value="${s.accentColor}" style="width:18px;height:18px;border:none;border-radius:50%;cursor:pointer;padding:0;background:none;">
              </div>
            </div>
            <div class="sp-row">
              <span class="sp-row-lbl">Prediction cell color</span>
              <div style="display:flex;align-items:center;gap:5px;">
                ${mkSwatches('predcolor', s.predColor)}
                <input type="color" id="sp-pred-custom" value="${s.predColor}" style="width:18px;height:18px;border:none;border-radius:50%;cursor:pointer;padding:0;background:none;">
              </div>
            </div>
          </div>

          <div class="sp-card wide">
            <div class="sp-card-title">🎮 Gameplay</div>
            <div class="sp-row"><span class="sp-row-lbl">Highlight site grid cells</span><div class="tog ${s.highlightSite?'on':''}" data-setting="highlightSite"></div></div>
            <div class="sp-row"><span class="sp-row-lbl">Click-through panel cells</span><div class="tog ${s.autoClickCells?'on':''}" data-setting="autoClickCells"></div></div>
          </div>

          <div class="sp-card wide">
            <div class="sp-card-title">⚡ Performance</div>
            <div class="sp-row">
              <span class="sp-row-lbl">Prediction delay</span>
              <select class="sp-sel" id="sp-pred-delay">
                <option value="400"  ${s.predDelay===400 ?'selected':''}>Fast (0.4s)</option>
                <option value="800"  ${s.predDelay===800 ?'selected':''}>Normal (0.8s)</option>
                <option value="1200" ${s.predDelay===1200?'selected':''}>Slow (1.2s)</option>
              </select>
            </div>
          </div>

        </div>
      </div>
      <div class="sp-foot">
        <span class="sp-foot-txt">🐺 Bloxflip.com · CUDA Predictor</span>
        <div class="sp-btns">
          <button class="sp-btn sp-btn-ghost" id="sp-reset">Reset</button>
          <button class="sp-btn sp-btn-save"  id="sp-save">Save</button>
        </div>
      </div>
    `;
  }

  const popup = document.createElement('div');
  popup.id = 'CUDA-settings-popup';
  popup.className = 'cuda-popup';
  document.body.appendChild(popup);

  /* ══ APPLY SETTINGS ══ */
  function applySettings(s) {
    // UI scale — transform-origin bottom center so bar stays anchored
    bar.style.transformOrigin = 'bottom center';
    bar.style.transform = `translateX(-50%) scale(${s.uiScale / 100})`;

    // Grid opacity
    const grid = document.getElementById('CUDA-grid');
    if (grid) grid.style.opacity = (s.gridOpacity / 100).toString();

    // Animations
    bar.classList.toggle('no-anim', !s.animations);

    // Accent CSS vars
    document.documentElement.style.setProperty('--accent',  s.accentColor);
    document.documentElement.style.setProperty('--accent2', s.accentColor);
    document.documentElement.style.setProperty('--acc-bg',  s.accentColor + '26');

    // Pred color
    updatePredStyle(s.predColor);

    // Site highlights
    if (s.highlightSite && lastIndices.length) applySiteHighlights(lastIndices);
    else if (!s.highlightSite) clearSiteHighlights();
  }

  function wireSettings() {
    popup.innerHTML = buildSettingsHTML();

    popup.querySelectorAll('.tog[data-setting]').forEach(t =>
      t.addEventListener('click', () => { sfxToggle(); t.classList.toggle('on'); })
    );

    // Live slider labels
    const scaleEl = popup.querySelector('#sp-ui-scale');
    const scaleVal = popup.querySelector('#sp-ui-scale-val');
    scaleEl.addEventListener('input', () => {
      scaleVal.textContent = scaleEl.value + '%';
      // Live preview scale
      bar.style.transform = `translateX(-50%) scale(${scaleEl.value / 100})`;
    });

    const opEl = popup.querySelector('#sp-opacity');
    const opVal = popup.querySelector('#sp-opacity-val');
    opEl.addEventListener('input', () => {
      opVal.textContent = opEl.value + '%';
      const g = document.getElementById('CUDA-grid');
      if (g) g.style.opacity = (opEl.value / 100).toString();
    });

    // Accent swatches
    popup.querySelectorAll('[data-accent]').forEach(sw => {
      sw.addEventListener('click', () => {
        sfxSelect();
        popup.querySelectorAll('[data-accent]').forEach(s => s.style.border = '2px solid transparent');
        sw.style.border = '2px solid #fff';
        popup.querySelector('#sp-accent-custom').value = sw.dataset.accent;
      });
    });
    popup.querySelector('#sp-accent-custom').addEventListener('input', e => {
      popup.querySelectorAll('[data-accent]').forEach(s => s.style.border = '2px solid transparent');
      // Live preview accent
      document.documentElement.style.setProperty('--accent',  e.target.value);
      document.documentElement.style.setProperty('--accent2', e.target.value);
    });

    // Pred color swatches
    popup.querySelectorAll('[data-predcolor]').forEach(sw => {
      sw.addEventListener('click', () => {
        sfxSelect();
        popup.querySelectorAll('[data-predcolor]').forEach(s => s.style.border = '2px solid transparent');
        sw.style.border = '2px solid #fff';
        popup.querySelector('#sp-pred-custom').value = sw.dataset.predcolor;
        updatePredStyle(sw.dataset.predcolor);
      });
    });
    popup.querySelector('#sp-pred-custom').addEventListener('input', e => {
      popup.querySelectorAll('[data-predcolor]').forEach(s => s.style.border = '2px solid transparent');
      updatePredStyle(e.target.value);
    });

    // Save
    popup.querySelector('#sp-save').addEventListener('click', () => {
      sfxApply();
      popup.querySelectorAll('.tog[data-setting]').forEach(t => {
        settings[t.dataset.setting] = t.classList.contains('on');
      });
      settings.uiScale     = parseInt(popup.querySelector('#sp-ui-scale').value);
      settings.gridOpacity = parseInt(popup.querySelector('#sp-opacity').value);
      settings.accentColor = popup.querySelector('#sp-accent-custom').value;
      settings.predColor   = popup.querySelector('#sp-pred-custom').value;
      settings.predDelay   = parseInt(popup.querySelector('#sp-pred-delay').value);
      saveSettings(settings);
      applySettings(settings);
      closeAll();
    });

    // Reset
    popup.querySelector('#sp-reset').addEventListener('click', () => {
      sfxClick();
      settings = { ...defaultSettings };
      saveSettings(settings);
      applySettings(settings);
      wireSettings(); // rebuild with defaults
    });

    // Close X
    popup.querySelector('#sp-close').addEventListener('click', () => { sfxClose(); closeAll(); });
  }

  /* ══ ALGO POPUP ══ */
  const algoData = [
    { id:'howlsplus',   icon:'✦',  name:'HowlS+',       desc:'Advanced sequential pattern resolver' },
    { id:'yolov24',     icon:'⚡', name:'Yolo V2.4',     desc:'High-risk high-reward prediction engine' },
    { id:'howlsv1',     icon:'⭐', name:'HowlS V1',      desc:'Classic sequence-based prediction method' },
    { id:'coxyalgo5',   icon:'🔷', name:'CoxyAlgo5',     desc:'Fifth-gen Coxy optimised algo' },
    { id:'algoswitch',  icon:'🔄', name:'AlgoSwitch',    desc:'Dynamically switches between top algos' },
    { id:'randomize',   icon:'🎲', name:'Randomize',     desc:'Controlled pseudo-random distribution' },
    { id:'onesenmeth',  icon:'1️⃣', name:'OneSenMethod', desc:'Single sensitivity sweep prediction' },
    { id:'twosenmeth',  icon:'2️⃣', name:'TwoSenMethod', desc:'Dual sensitivity cross-validation' },
    { id:'pastgames',   icon:'📊', name:'PastGames',     desc:'Analyses previous game history' },
    { id:'qoftmines',   icon:'💎', name:'QoftMines',     desc:'Quantity-of-field thermal mapping' },
    { id:'semirandom',  icon:'🔀', name:'SemiRandom',    desc:'Weighted stochastic randomisation' },
    { id:'thermalscan', icon:'🌡', name:'ThermalScan',   desc:'Heatmap-based zone prediction' },
  ];
  let selectedAlgos = ['howlsplus','yolov24','howlsv1','coxyalgo5'];

  const algoPopup = document.createElement('div');
  algoPopup.id = 'CUDA-algo-popup';
  algoPopup.className = 'cuda-popup';
  document.body.appendChild(algoPopup);

  function buildAlgoPopup() {
    algoPopup.innerHTML = `
      <div class="sp-head">
        <div class="sp-title">Algorithm Select <small>Pick up to 4</small></div>
        <div class="sp-x" id="algo-close">✕</div>
      </div>
      <div class="sp-body">
        <div class="sp-card wide">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;">
            <div class="sp-card-title" style="margin-bottom:0">⚡ Available Algorithms</div>
            <span class="algo-selected-count">Selected: <span id="algo-count">${selectedAlgos.length}</span>/4</span>
          </div>
          <div class="algo-grid" id="algo-grid-inner"></div>
        </div>
      </div>
      <div class="sp-foot">
        <span class="sp-foot-txt">Selected algorithms replace the 4 algo nav buttons</span>
        <div class="sp-btns">
          <button class="sp-btn sp-btn-ghost" id="algo-reset-btn">Reset</button>
          <button class="sp-btn sp-btn-save"  id="algo-save-btn">Apply</button>
        </div>
      </div>
    `;
    const gridEl = algoPopup.querySelector('#algo-grid-inner');
    algoData.forEach(a => {
      const card = document.createElement('div');
      card.className = 'algo-card' + (selectedAlgos.includes(a.id) ? ' selected' : '');
      card.dataset.id = a.id;
      card.innerHTML = `<div class="algo-card-icon">${a.icon}</div><div class="algo-card-info"><div class="algo-card-name">${a.name}</div><div class="algo-card-desc">${a.desc}</div></div><div class="algo-card-check">✓</div>`;
      card.addEventListener('click', () => {
        sfxSelect();
        if (selectedAlgos.includes(a.id)) { selectedAlgos = selectedAlgos.filter(x=>x!==a.id); card.classList.remove('selected'); }
        else { if (selectedAlgos.length >= 4) return; selectedAlgos.push(a.id); card.classList.add('selected'); }
        algoPopup.querySelector('#algo-count').textContent = selectedAlgos.length;
      });
      gridEl.appendChild(card);
    });
    algoPopup.querySelector('#algo-close').addEventListener('click', () => { sfxClose(); closeAll(); });
    algoPopup.querySelector('#algo-reset-btn').addEventListener('click', () => { sfxClick(); selectedAlgos=['howlsplus','yolov24','howlsv1','coxyalgo5']; buildAlgoPopup(); });
    algoPopup.querySelector('#algo-save-btn').addEventListener('click', () => { sfxApply(); applyAlgoSlots(); closeAll(); });
  }

  function applyAlgoSlots() {
    selectedAlgos.forEach((id, i) => {
      const a = algoData.find(x=>x.id===id);
      const lbl = document.getElementById('algo-slot-label-'+i);
      const ico = document.getElementById('algo-slot-icon-'+i);
      if (lbl && a) lbl.textContent = a.name;
      if (ico && a) ico.textContent = a.icon;
    });
  }

  /* ══ UPDATES POPUP ══ */
  const updatesPopup = document.createElement('div');
  updatesPopup.id = 'CUDA-updates-popup';
  updatesPopup.className = 'cuda-popup';
  updatesPopup.innerHTML = `
    <div class="sp-head"><div class="sp-title">Patch Notes <small>CUDA Updates</small></div><div class="sp-x" id="updates-close">✕</div></div>
    <div class="sp-body"><div class="patch-list">
      <div class="patch-entry latest"><div class="patch-header"><span class="patch-ver">v7.5</span><span class="patch-badge">Latest</span><span class="patch-date">Today</span></div><div class="patch-changes">
        <div class="patch-line new">Full settings rewrite — all options now functional</div>
        <div class="patch-line new">UI scale, accent color, pred color, bar position</div>
        <div class="patch-line new">CUDA idle logo in mines grid when no prediction active</div>
        <div class="patch-line tweak">Removed auto-detect game — manual algo control only</div>
        <div class="patch-line fix">Fixed shared state hoisting crash (lastIndices ReferenceError)</div>
      </div></div>
      <div class="patch-entry mid"><div class="patch-header"><span class="patch-ver">v7.4</span><span class="patch-date">Yesterday</span></div><div class="patch-changes">
        <div class="patch-line new">Cell click passthrough to site mine grid</div>
        <div class="patch-line new">Site grid green glow highlights on predictions</div>
        <div class="patch-line tweak">10% larger UI across the board</div>
      </div></div>
      <div class="patch-entry old"><div class="patch-header"><span class="patch-ver">v7.0 – 7.3</span><span class="patch-date">Last week</span></div><div class="patch-changes">
        <div class="patch-line new">Complete UI rewrite — floating pill design</div>
        <div class="patch-line new">Algorithm picker, Updates panel, Unrig popup</div>
        <div class="patch-line fix">Safari backdrop-filter fix applied</div>
      </div></div>
    </div></div>
    <div class="updates-footer">
      <span class="updates-footer-txt"><span class="updates-dot"></span>v7.5 live</span>
      <div class="sp-btns"><button class="sp-btn sp-btn-save" id="updates-dismiss">Dismiss</button></div>
    </div>
  `;
  document.body.appendChild(updatesPopup);

  /* ══ UNRIG POPUP ══ */
  let selectedUnrigMode = 'soft', selectedUnrigType = 'pattern';
  const unrigPopup = document.createElement('div');
  unrigPopup.id = 'CUDA-unrig-popup';
  unrigPopup.className = 'cuda-popup';
  const unrigModes = [
    { id:'soft',       icon:'🌊', name:'Soft Unrig',   desc:'Gentle correction — subtle bias removal' },
    { id:'medium',     icon:'⚡', name:'Medium Unrig', desc:'Balanced override of server-side weighting' },
    { id:'aggressive', icon:'🔥', name:'Aggressive',   desc:'Full seed-chain disruption attempt' },
  ];
  const unrigTypes = [
    { id:'pattern', icon:'🔷', label:'Pattern' }, { id:'entropy', icon:'🌀', label:'Entropy' },
    { id:'mirror',  icon:'🪞', label:'Mirror'  }, { id:'cascade', icon:'💠', label:'Cascade' },
    { id:'inverse', icon:'🔄', label:'Inverse' }, { id:'hybrid',  icon:'⚗️', label:'Hybrid'  },
  ];

  function buildUnrigPopup() {
    unrigPopup.innerHTML = `
      <div class="sp-head"><div class="sp-title">Unrig <small>Mode &amp; Type</small></div><div class="sp-x" id="unrig-close">✕</div></div>
      <div class="sp-body">
        <div class="unrig-section">
          <div class="unrig-section-title">⚖ Unrig Mode</div>
          ${unrigModes.map(m=>`<div class="unrig-option${m.id===selectedUnrigMode?' selected':''}" data-mode="${m.id}"><div class="unrig-opt-icon">${m.icon}</div><div class="unrig-opt-info"><div class="unrig-opt-name">${m.name}</div><div class="unrig-opt-desc">${m.desc}</div></div><div class="unrig-opt-dot"></div></div>`).join('')}
        </div>
        <div class="unrig-divider"></div>
        <div class="unrig-section">
          <div class="unrig-section-title">🔀 Unrig Type</div>
          <div class="unrig-type-grid">
            ${unrigTypes.map(t=>`<div class="unrig-type-chip${t.id===selectedUnrigType?' selected':''}" data-type="${t.id}"><div class="utc-icon">${t.icon}</div><div class="utc-label">${t.label}</div></div>`).join('')}
          </div>
        </div>
      </div>
      <div class="sp-foot">
        <span class="sp-foot-txt">Affects grid prediction bias correction</span>
        <div class="sp-btns"><button class="sp-btn sp-btn-ghost" id="unrig-cancel">Cancel</button><button class="sp-btn sp-btn-save" id="unrig-apply">Apply</button></div>
      </div>
    `;
    unrigPopup.querySelectorAll('.unrig-option').forEach(opt => opt.addEventListener('click', () => {
      sfxSelect(); selectedUnrigMode = opt.dataset.mode;
      unrigPopup.querySelectorAll('.unrig-option').forEach(o=>o.classList.remove('selected'));
      opt.classList.add('selected');
    }));
    unrigPopup.querySelectorAll('.unrig-type-chip').forEach(chip => chip.addEventListener('click', () => {
      sfxSelect(); selectedUnrigType = chip.dataset.type;
      unrigPopup.querySelectorAll('.unrig-type-chip').forEach(c=>c.classList.remove('selected'));
      chip.classList.add('selected');
    }));
    unrigPopup.querySelector('#unrig-close').addEventListener('click', () => { sfxClose(); closeAll(); });
    unrigPopup.querySelector('#unrig-cancel').addEventListener('click', () => { sfxClick(); closeAll(); });
    unrigPopup.querySelector('#unrig-apply').addEventListener('click', () => { sfxApply(); closeAll(); });
  }
  document.body.appendChild(unrigPopup);

  /* ══ POPUP MANAGEMENT ══ */
  let openPopup = null;

  function closeAll() {
    [popup, algoPopup, updatesPopup, unrigPopup].forEach(p => p.classList.remove('open'));
    // Only clear non-algo-slot active states
    document.querySelectorAll('.btn-tile:not(.ingame-tile):not(.algo-slot)').forEach(b => b.classList.remove('active'));
    openPopup = null;
  }

  function togglePopup(p, btn) {
    if (openPopup === p) { sfxClose(); closeAll(); return; }
    sfxOpen(); closeAll();
    p.classList.add('open');
    if (btn) btn.classList.add('active');
    openPopup = p;
  }

  /* ══ COLLAPSE ══ */
  document.getElementById('CUDA-handle').addEventListener('click', () => {
    sfxClose(); bar.classList.add('collapsed'); clearSiteHighlights(); closeAll();
  });
  document.getElementById('CUDA-mini').addEventListener('click', () => {
    sfxOpen(); bar.classList.remove('collapsed');
  });

  /* ══ SETTINGS BUTTON ══ */
  const sBtn = document.getElementById('nav-settings-btn');
  sBtn.addEventListener('click', e => {
    e.stopPropagation();
    wireSettings();
    togglePopup(popup, sBtn);
  });

  /* ══ ALGO BUTTON ══ */
  const algoBtn = document.getElementById('nav-algo-btn');
  algoBtn.addEventListener('click', e => {
    e.stopPropagation();
    if (openPopup === algoPopup) { sfxClose(); closeAll(); return; }
    buildAlgoPopup(); sfxOpen(); closeAll();
    algoPopup.classList.add('open'); algoBtn.classList.add('active'); openPopup = algoPopup;
  });

  /* ══ UPDATES BUTTON ══ */
  const updatesBtn = document.getElementById('nav-updates-btn');
  updatesBtn.addEventListener('click', e => { e.stopPropagation(); togglePopup(updatesPopup, updatesBtn); });
  document.getElementById('updates-close').addEventListener('click', () => { sfxClose(); closeAll(); });
  document.getElementById('updates-dismiss').addEventListener('click', () => { sfxClick(); closeAll(); });

  /* ══ UNRIG BUTTON ══ */
  const unrigBtn = document.getElementById('nav-unrig-btn');
  unrigBtn.addEventListener('click', e => {
    e.stopPropagation();
    if (openPopup === unrigPopup) { sfxClose(); closeAll(); return; }
    buildUnrigPopup(); sfxOpen(); closeAll();
    unrigPopup.classList.add('open'); unrigBtn.classList.add('active'); openPopup = unrigPopup;
  });

  /* ══ DISCORD ══ */
  document.getElementById('nav-discord-btn').addEventListener('click', () => {
    sfxClick(); window.open('https://discord.gg/yourinvite', '_blank');
  });

  /* ══ OUTSIDE CLICK ══ */
  document.addEventListener('mousedown', e => {
    if (openPopup && !openPopup.contains(e.target) && !bar.contains(e.target)) { sfxClose(); closeAll(); }
  });

  /* ══ NAV ALGO SLOTS ══ */
  const algoSlotIndices = {
    'algo-slot-0': [0, 5, 17, 24],
    'algo-slot-1': [2, 7, 12, 17, 22],
    'algo-slot-2': [6, 8, 16, 18],
    'algo-slot-3': [1, 3, 21, 23],
  };

  let activeSlotNav = 'algo-slot-0'; // always one selected

  function setActiveSlot(nav) {
    activeSlotNav = nav;
    lastPredIndices = algoSlotIndices[nav] || [];
    // Highlight only the active slot, clear others
    document.querySelectorAll('.btn-tile.algo-slot').forEach(t => {
      t.classList.toggle('active', t.getAttribute('data-nav') === nav);
    });
  }

  document.querySelectorAll('.btn-tile.algo-slot').forEach(t => {
    t.addEventListener('click', () => {
      sfxClick();
      const nav = t.getAttribute('data-nav');
      setActiveSlot(nav);
      // Only run prediction if currently in-game
      if (wasInGame) updateCUDAGrid(algoSlotIndices[nav] || []);
    });
  });

  // Highlight slot-0 by default on load
  setActiveSlot('algo-slot-0');

  /* ══ EYE TOGGLE ══ */
  document.getElementById('CUDA-eye').addEventListener('click', () => {
    sfxToggle(); vis = !vis;
    const grid = document.getElementById('CUDA-grid');
    if (grid) grid.style.opacity = vis ? (settings.gridOpacity/100).toString() : '0.06';
    if (vis) applySiteHighlights(lastIndices);
    else clearSiteHighlights();
  });

  /* ══ GAME STATE POLLING ══ */
  let wasInGame = false;

  async function pollGameState() {
    try {
      const res  = await fetch('https://bloxflip.com/api/games/mines');
      const data = await res.json();
      const inGame = data.success && data.hasGame;
      const ingameBtn = document.querySelector('.btn-tile.ingame-tile');

      if (inGame && !wasInGame) {
        wasInGame = true;
        // Light up In-game button
        if (ingameBtn) {
          ingameBtn.classList.add('ingame-active');
          ingameBtn.querySelector('.t-label').textContent = 'In-Game';
        }
        // Run prediction for active slot
        const idx = algoSlotIndices[activeSlotNav] || [];
        hideIdleOverlay();
        updateCUDAGrid(idx);

      } else if (!inGame && wasInGame) {
        wasInGame = false;
        // Reset In-game button
        if (ingameBtn) {
          ingameBtn.classList.remove('ingame-active');
          ingameBtn.querySelector('.t-label').textContent = 'In-game';
        }
        clearSiteHighlights();
        showIdleOverlay();
      }
    } catch(e) { /* offline / CORS — silently ignore */ }
  }

  /* ══ INIT ══ */
  applySettings(settings);
  showIdleOverlay();
  setInterval(pollGameState, 500);
  pollGameState();

  console.log('%c🐺 CUDA v7.5 Active','color:#4ade80;font-family:monospace;font-weight:bold;');
})();