//Rev-Map (7+)
async function run() {
  const gameRes = await fetch("https://bloxflip.com/api/games/mines");
  const gameData = await gameRes.json();

  if (!gameData.success || !gameData.hasGame) {
    console.log("No active game");
    return;
  }

  const minesAmount = gameData.game.minesAmount;

  const historyRes = await fetch("https://bloxflip.com/api/games/mines/history?page=0&size=50");
  const historyData = await historyRes.json();

  // last 4 games with same mine amount
  const games = historyData.data
    .filter(g => g.minesAmount === minesAmount)
    .slice(0, 4);

  if (games.length === 0) {
    console.log("No past games for this mine amount");
    return;
  }

  // 1️⃣ Take last game
  const lastGame = games[0].mineLocations.slice(); // copy

  // Pick first 4 spots (or all if less than 4)
  const picked = lastGame.slice(0, 4);

  // 2️⃣ Apply mirror pattern
  let mirrored = picked.map(num => 24 - num);

  // 3️⃣ Collect all previous spots from last 4 games
  const allPreviousSpots = new Set();
  games.forEach(g => g.mineLocations.forEach(n => allPreviousSpots.add(n)));

  // 4️⃣ Replace any mirrored spot that exists in previous 4 games
  for (let i = 0; i < mirrored.length; i++) {
    if (allPreviousSpots.has(mirrored[i])) {
      // try to find a replacement from last games in order
      let replaced = false;
      for (let g of games) {
        for (let spot of g.mineLocations) {
          const candidate = 24 - spot;
          if (!mirrored.includes(candidate) && !allPreviousSpots.has(candidate)) {
            mirrored[i] = candidate;
            replaced = true;
            break;
          }
        }
        if (replaced) break;
      }

      // if still not replaced, just pick next number in 0-24 not already in mirrored
      if (!replaced) {
        for (let n = 0; n < 25; n++) {
          if (!mirrored.includes(n) && !allPreviousSpots.has(n)) {
            mirrored[i] = n;
            break;
          }
        }
      }
    }
  }

  const finalSpots = mirrored.slice(0, 4);
  console.log("Predicted spots:", finalSpots);
}

run();


