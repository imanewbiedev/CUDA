  /* ══ SITE GRID ══ */
  function clearSiteHighlights() {
    document.querySelectorAll('.mines-module-scss-module__gUfZ2G__minesGameItem').forEach(btn => {
      btn.style.removeProperty('background');
      btn.style.removeProperty('border');
      btn.style.removeProperty('box-shadow');
    });
  }

  function applySiteHighlights(indices) {
    clearSiteHighlights();
    if (!settings.highlightSite) return;
    const c    = settings.accentColor;
    // convert hex to rgb for rgba usage
    const r    = parseInt(c.slice(1,3),16);
    const g    = parseInt(c.slice(3,5),16);
    const b    = parseInt(c.slice(5,7),16);
    const btns = document.querySelectorAll('.mines-module-scss-module__gUfZ2G__minesGameItem');
    indices.forEach(i => {
      const btn = btns[i];
      if (!btn) return;
      btn.style.background = `linear-gradient(rgba(${r},${g},${b},0), rgba(${r},${g},${b},0.20)), var(--mines-tile-color)`;
      btn.style.border     = `1px solid ${c}`;
      btn.style.boxShadow  = `0 0 6px ${c}, 0 0 12px ${c}`;
    });
  }

  /* ══ UPDATE GRID ══ */
  function updateCUDAGrid(indices = []) {
    const grid     = document.getElementById('CUDA-grid');
    const miniDots = document.getElementById('CUDA-mini-dots');
    if (!grid) return;

    hideIdleOverlay();
    sfxGrid();
    grid.innerHTML = `<div class="CUDA-loader"><div class="spinner"></div></div>`;

    setTimeout(() => {
      grid.innerHTML = '';
      if (miniDots) miniDots.innerHTML = '';
      let sfxDelay = 0;

      for (let i = 0; i < 25; i++) {
        const isTarget = indices.includes(i);
        const cell = document.createElement('div');
        cell.className = 'CUDA-cell ' + (isTarget ? 'predicted' : 'mine');
        cell.style.animationDelay = (i * 0.02) + 's';

        if (isTarget) {
          setTimeout(() => sfxPredCell(), 820 + sfxDelay);
          sfxDelay += 60;
        }

        const ci = i;
        cell.addEventListener('click', () => {
          if (!settings.autoClickCells) return;
          const btns = document.querySelectorAll('.mines-module-scss-module__gUfZ2G__minesGameItem');
          if (btns[ci]) btns[ci].click();
        });

        grid.appendChild(cell);

        if (miniDots && i < 10) {
          const dot = document.createElement('div');
          dot.className = 'mini-dot' + (isTarget ? ' p' : '');
          miniDots.appendChild(dot);
        }
      }

      lastIndices     = indices;
      lastPredIndices = indices;
      applySiteHighlights(indices);

    }, settings.predDelay);
  }

