async function run() {

  // Get current game
  const gameRes = await fetch("https://bloxflip.com/api/games/mines");
  const gameData = await gameRes.json();

  if (!gameData.success || !gameData.hasGame) {
    console.log("No active game");
    return;
  }

  const minesAmount = gameData.game.minesAmount;

  // Get history
  const historyRes = await fetch("https://bloxflip.com/api/games/mines/history?page=0&size=50");
  const historyData = await historyRes.json();

  // Filter games with same mine amount
  const filtered = historyData.data
    .filter(g => g.minesAmount === minesAmount)
    .slice(0, 4); // last 4 games

  // Count mine spot frequency
  const freq = {};

  filtered.forEach(game => {
    game.mineLocations.forEach(loc => {
      freq[loc] = (freq[loc] || 0) + 1;
    });
  });

  // Get repeated spots
  let repeated = Object.keys(freq)
    .filter(k => freq[k] > 1)
    .map(Number);

  // Ensure only unique values
  const result = [...new Set(repeated)];

  // Fill with random spots if less than 4
  while (result.length < 4) {
    const rand = Math.floor(Math.random() * 25); // 0-24
    if (!result.includes(rand)) {
      result.push(rand);
    }
  }

  // Limit to exactly 4
  const finalSpots = result.slice(0, 4);

  console.log("Predicted spots:", finalSpots);
}

